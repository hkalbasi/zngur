type crate::Heaped {
    #heap_allocate;

    field a (offset = 0, type = i32);
}

type crate::RefOnly {
    #only_by_ref;

    field a (offset = 0, type = i32);
}

type crate::Stacked {
    #layout(size = 8, align = 4);

    field a (offset = 0, type = i32);
    field b (offset = 4, type = i32);
}

type crate::Wide {
    #layout_conservative(size = 16, align = 8);

    field a (offset = 0, type = i32);
}
