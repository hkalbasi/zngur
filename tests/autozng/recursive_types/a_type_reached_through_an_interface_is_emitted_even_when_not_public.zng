type crate::Child {
    #layout(size = 4, align = 4);

    field value (offset = 0, type = u32);

    safe fn sibling(&self) -> crate::Sibling;
}

type crate::Root {
    #layout(size = 4, align = 4);

    field child (offset = 0, type = crate::Child);
}

type crate::Sibling {
    #layout(size = 4, align = 4);

    field value (offset = 0, type = u32);

    safe fn back(&self) -> crate::Child;
}
