type ::std::string::String {
    #layout(size = 24, align = 8);
    wellknown_traits(Debug);
}

type crate::Person {
    #layout(size = 24, align = 8);
    constructor {name: ::std::string::String};

    field name (offset = 0, type = ::std::string::String);

    safe fn greet(&self) -> ::std::string::String use crate::Greet;
}
